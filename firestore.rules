rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── helpers ──────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    // Admin check: verified against the Firebase token email.
    // To add admins update NEXT_PUBLIC_ADMIN_EMAILS AND this list.
    function isAdmin() {
      return signedIn() &&
             request.auth.token.email in [
               'daianefeliciano.df@gmail.com'
             ];
    }

    // ─── admin content collections (devotionals, events, announcements) ───────
    // Admins can create / update / delete.
    // Authenticated users (mobile app) can read.
    // Public can also read these (no-login read on mobile).

    match /devotionals/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /events/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /avisos/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pdfs/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /resources/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /negocios/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ─── user profiles ────────────────────────────────────────────────────────
    match /usuarias/{uid} {
      function myProfile() {
        return get(/databases/$(database)/documents/usuarias/$(request.auth.uid)).data;
      }

      function isLeader() {
        return signedIn() && myProfile().papel == 'lider';
      }

      function isMe(userId) {
        return signedIn() && request.auth.uid == userId;
      }

      allow create: if isMe(uid)
        && request.resource.data.papel == 'membro'
        && request.resource.data.discipuladoraId == null
        && request.resource.data.igrejaId == null
        && request.resource.data.liderId == null;

      allow read: if isMe(uid) || isLeader() || isAdmin();

      allow update: if isMe(uid)
        && request.resource.data.papel == resource.data.papel
        && request.resource.data.discipuladoraId == resource.data.discipuladoraId
        && request.resource.data.igrejaId == resource.data.igrejaId
        && request.resource.data.liderId == resource.data.liderId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nome', 'ultimoAcesso', 'ultimoDiaDevocionalLido']);

      allow update: if isLeader()
        && resource.data.papel == 'membro'
        && request.resource.data.papel == resource.data.papel
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['discipuladoraId', 'ultimoVinculoEm']);

      allow delete: if false;
    }

    // ─── default: deny everything else ────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
