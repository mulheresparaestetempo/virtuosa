# Firebase Web Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=abba-virtuosa-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=abba-virtuosa-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=abba-virtuosa-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_ID

# Firebase Admin (Backend only)
FIREBASE_ADMIN_SDK_KEY=your-admin-sdk-key.json

# Backend Configuration
BACKEND_FUNCTIONS_URL=https://YOUR_REGION-abba-virtuosa-app.cloudfunctions.net

# AI Configuration
CLAUDE_API_KEY=your-claude-api-key
OPENAI_API_KEY=your-openai-api-key
