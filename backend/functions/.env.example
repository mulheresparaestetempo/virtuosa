# Firebase Configuration
FIREBASE_PROJECT_ID=abba-virtuosa-app
FIREBASE_DATABASE_URL=https://abba-virtuosa-app.firebaseio.com
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY

# Email Configuration
FIREBASE_EMAIL=your-email@gmail.com
FIREBASE_EMAIL_PASSWORD=your-app-password

# AI/API Keys
CLAUDE_API_KEY=your-claude-api-key
OPENAI_API_KEY=your-openai-api-key

# Notification Configuration
NOTIFICATION_TITLE_PREFIX=FILHA
NOTIFICATION_ICON_URL=https://your-cdn.com/icon.png

# Feature Flags
ENABLE_AI_ASSISTANT=true
ENABLE_COMMUNITY=true
ENABLE_EVENTS=true

# Environment
NODE_ENV=production
REGION=us-central1
